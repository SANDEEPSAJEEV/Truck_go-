{
  "expo": {
    "name": "TruckGo Driver",
    "slug": "truckgo-driver",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "driverapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.truckgo.driver",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.truckgo.driver",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#ED8936",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ED8936",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ED8936",
          "defaultChannel": "loads"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TruckGo to use your location to show your position, receive nearby rides, and share live tracking.",
          "locationAlwaysAndWhenInUsePermission": "Allow TruckGo to share your live location with the customer for the entire trip, even in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4ef090a-6632-4c82-a316-1de347ee861b"
      }
    },
    "owner": "sandippp"
  }
}
