# Secrets. These hold the Neon database password, Razorpay keys and Google Maps keys —
# nothing in here is ever committed. `.env.example` files are tracked instead.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
dist-web/
build/
*.tsbuildinfo

