# ---------------------------------------------------------------------------------------
# TruckGo backend configuration.
#
# Every environment is a SEPARATE database on a SEPARATE host. That separation is the only
# thing that actually prevents a development mistake from reaching production data — not
# discipline, not naming conventions. Dev has no network route to the production database.
#
#   local dev  -> Postgres on your machine        (truckgo_dev)
#   staging    -> managed Postgres, own instance  (truckgo_staging)
#   production -> managed Postgres, own instance  (truckgo_prod)
#
# Never point a local .env at a production DATABASE_URL, even "just to check something".
# ---------------------------------------------------------------------------------------

# Local development. See docs/DATABASE-SETUP.md for creating this role and database.
DATABASE_URL="postgresql://truckgo:CHANGE_ME@localhost:5432/truckgo_dev?schema=public"

# Managed Postgres in production looks like this instead — note sslmode:
# DATABASE_URL="postgresql://user:pass@host.ap-south-1.rds.amazonaws.com:5432/truckgo_prod?schema=public&sslmode=require"

PORT=3001
NODE_ENV=development

# --- Secrets ---------------------------------------------------------------------------
# Required. The server refuses to start in production if these are unset, rather than
# falling back to a secret published in this repository.
#
# Generate a distinct value PER ENVIRONMENT:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Sharing a secret across environments means a token minted in dev authenticates in prod.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
# Signs the short-lived proof that a phone number was verified, which registration demands.
JWT_VERIFICATION_SECRET="change-me-verification"

# Comma-separated browser origins allowed to call this API. Native apps send no Origin
# header and are unaffected. Left empty outside production, everything is allowed so the
# Expo web preview works on whichever port it picks.
CORS_ORIGINS=

# --- SMS (phone verification, trip PIN backup) ------------------------------------------
# Without these the mock provider logs codes to the console instead of sending them, which
# is fine for development and refused in production.
# MSG91 is India-first: ~₹0.15-0.25/SMS vs Twilio's ~₹0.45-0.63, with assisted DLT support.
# Sending ANY transactional SMS in India requires DLT registration first — a government
# process measured in days, so start it early.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# --- Driver KYC --------------------------------------------------------------------------
# Verifies driving licences and vehicle registrations against government records (Sarathi /
# Vahan). Without it the mock provider is used, which enforces formats but cannot confirm a
# document is real — production refuses to start without a real token.
SUREPASS_TOKEN=

# --- Maps / routing ----------------------------------------------------------------------
# Server-side key for Directions/Places/Geocoding. Kept here, never in the app bundle: the
# original APK shipped its key, so anyone who decompiled it could bill the account.
# Unset, routing falls back to OSRM (free, no key, fine for development).
GOOGLE_MAPS_SERVER_KEY=
# Self-hosted OSRM instance. The public demo server is rate-limited with no uptime
# guarantee — acceptable for dev, not for production traffic.
OSRM_URL=

# Where uploaded identity documents are written. Served only through an authenticated
# route, never from a public directory. Production should use S3/R2 instead of local disk.
UPLOAD_DIR=

# --- Payments (Razorpay) -----------------------------------------------------------------
# Without these the mock provider is used: order creation returns a fake order id and the
# rider's screen gets a "Simulate payment" button instead of a real checkout. Production
# refuses to start without real keys — collecting money through a mock would mean silently
# never actually getting paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configured separately in the Razorpay dashboard (Settings -> Webhooks), NOT the same as
# the API key secret above. Required to verify that a webhook actually came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=
